# =====================================================
# librobotcontrol Cross-Compilation Wrapper (Windows/MSYS2)
# =====================================================
# This Makefile is designed for cross-compiling on Windows using
# the ARM GNU Toolchain and MSYS2. It enforces static linking
# to avoid GLIBC version mismatches on the target.
# =====================================================

SHELL := /usr/bin/bash
.EXPORT_ALL_VARIABLES:

# Root directory of this Makefile (absolute path)
ROOT_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))

# Check if TOOLCHAIN_DIR is set (usually done by startEclipse.cmd)
ifndef TOOLCHAIN_DIR
$(error TOOLCHAIN_DIR is not set. Please run the build via 'startEclipse.cmd' to set up the environment)
endif

# IMPORTANT: Use -m for "mixed" paths so Make handles Windows paths correctly
LIBROBOTCONTROL_STATIC := $(shell cygpath -m "$(ROOT_DIR)/library/lib/librobotcontrol.a")
export LIBROBOTCONTROL_STATIC

# =====================================================
# Toolchain Configuration
# =====================================================

PREFIX  := arm-none-linux-gnueabihf-
TC_BIN  := $(shell cygpath -u "$(TOOLCHAIN_DIR)/bin")

CC      = $(TC_BIN)/$(PREFIX)gcc
CXX     = $(TC_BIN)/$(PREFIX)g++
AR      = $(TC_BIN)/$(PREFIX)ar
LD      = $(TC_BIN)/$(PREFIX)ld
STRIP   = $(TC_BIN)/$(PREFIX)strip
LINKER  = $(CC)

# Add toolchain to path
export PATH := /usr/bin:$(TC_BIN):$(PATH)
# Prevent MSYS2 from mangling paths starting with /
export MSYS2_ARG_CONV_EXCL := *

# Sysroot configuration
SYSROOT_DIR ?= arm-sysroot
SYSROOT := $(ROOT_DIR)/$(SYSROOT_DIR)
export SYSROOT

# Mixed paths for GCC includes
ROOT_WIN := $(shell cygpath -m "$(ROOT_DIR)")
SYSROOT_WIN := $(shell cygpath -m "$(SYSROOT)")

export CFLAGS := -I$(ROOT_WIN)/library/include -I$(SYSROOT_WIN)/include

# =====================================================
# Linker Flags (Static Linking)
# =====================================================
# We force static linking (-static) to include GLIBC and libgpiod directly into the binary.
# This ensures compatibility with older Linux kernels on the BeagleBone.
# NOTE: Requires 'libgpiod.a' to be present in $(SYSROOT)/lib/
export LDFLAGS := -L$(ROOT_WIN)/library/lib \
                  -L$(SYSROOT_WIN)/lib \
                  -lrobotcontrol \
                  -lgpiod -lm -lrt -pthread -static

# =====================================================
# Build Targets
# =====================================================

all: check_dependencies
	@echo ">>> 1. Building LIBRARY..."
	cd "$(ROOT_DIR)" && mkdir -p library/lib && \
	$(MAKE) -f Makefile --no-print-directory V=1 \
	TOOLCHAIN_DIR="$(TOOLCHAIN_DIR)" \
	CC="$(CC)" CXX="$(CXX)" AR="$(AR)" LD="$(LD)" LINKER="$(LINKER)" \
	CFLAGS="$(CFLAGS)" \
	LIBROBOTCONTROL_STATIC="$(LIBROBOTCONTROL_STATIC)"

	@echo ">>> 2. Building ALL EXAMPLES..."
	cd "$(ROOT_DIR)/examples" && \
	$(MAKE) -f Makefile --no-print-directory \
	TOOLCHAIN_DIR="$(TOOLCHAIN_DIR)" \
	GPIOD_SYSROOT="$(SYSROOT_WIN)" \
	CC="$(CC)" CXX="$(CXX)" AR="$(AR)" LD="$(LD)" LINKER="$(LINKER)" \
	CFLAGS="$(CFLAGS)" \
	LDFLAGS="$(LDFLAGS)"

# Sanity check to ensure the static library exists in the repo
check_dependencies:
	@if [ ! -f "$(SYSROOT)/lib/libgpiod.a" ]; then \
		echo "ERROR: libgpiod.a not found in $(SYSROOT)/lib/"; \
		echo "       This file is required for static linking."; \
		exit 1; \
	fi

clean:
	cd "$(ROOT_DIR)" && $(MAKE) -f Makefile --no-print-directory clean

install uninstall:
	cd "$(ROOT_DIR)" && $(MAKE) -f Makefile --no-print-directory $@

# =====================================================
# Deploy Configuration
# =====================================================
# Use ?= to allow overriding via command line
# Example: make deploy TARGET_IP=192.168.1.50

TARGET_USER ?= debian
TARGET_IP   ?= 192.168.7.2
TARGET_PATH ?= /home/$(TARGET_USER)/rc-build

deploy:
	@echo ">>> Deploying to $(TARGET_USER)@$(TARGET_IP):$(TARGET_PATH)..."
	rsync -avz --delete "$(ROOT_DIR)/library/lib/" $(TARGET_USER)@$(TARGET_IP):$(TARGET_PATH)/lib/
	rsync -avz --delete "$(ROOT_DIR)/examples/"     $(TARGET_USER)@$(TARGET_IP):$(TARGET_PATH)/examples/

run:
	ssh $(TARGET_USER)@$(TARGET_IP) 'cd $(TARGET_PATH)/examples/bin && ./rc_test_drivers'