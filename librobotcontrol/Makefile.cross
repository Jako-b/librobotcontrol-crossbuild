# =====================================================
# librobotcontrol cross build wrapper (FORCE MODE)
# =====================================================

SHELL := /usr/bin/bash
.EXPORT_ALL_VARIABLES:

# Root directory of this Makefile (absolute path)
ROOT_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))

# WICHTIG: Wir nutzen -m für "Mixed" Pfade (C:/Users/...), damit Make keine Backslashes verschluckt!
LIBROBOTCONTROL_STATIC := $(shell cygpath -m "$(ROOT_DIR)/library/lib/librobotcontrol.a")
export LIBROBOTCONTROL_STATIC

# =====================================================
# Toolchain configuration
# =====================================================

# expect TOOLCHAIN_DIR to be provided by startEclipse.cmd
PREFIX := arm-none-linux-gnueabihf-
TC_BIN := $(shell cygpath -u "$(TOOLCHAIN_DIR)/bin")

CC      = $(TC_BIN)/$(PREFIX)gcc
CXX     = $(TC_BIN)/$(PREFIX)g++
AR      = $(TC_BIN)/$(PREFIX)ar
LD      = $(TC_BIN)/$(PREFIX)ld
STRIP   = $(TC_BIN)/$(PREFIX)strip
LINKER  = $(CC)

export PATH := /usr/bin:$(TC_BIN):$(PATH)
export MSYS2_ARG_CONV_EXCL := *

SYSROOT := $(ROOT_DIR)/arm-sysroot
export SYSROOT
# Auch hier -m für sichere Pfade
ROOT_WIN := $(shell cygpath -m "$(ROOT_DIR)")
SYSROOT_WIN := $(shell cygpath -m "$(SYSROOT)")

export CFLAGS := -I$(ROOT_WIN)/library/include -I$(SYSROOT_WIN)/include

# =====================================================
# FORCE LDFLAGS
# Hier definieren wir ALLES, was der Linker braucht.
# Wir geben ihm die .a Datei direkt (kein -l), damit er sie garantiert findet.
# =====================================================
export LDFLAGS := -L$(ROOT_WIN)/library/lib \
                  -L$(SYSROOT_WIN)/lib \
                  -lrobotcontrol \
                  -lgpiod -lm -lrt -pthread

# =====================================================
# Build Targets
# =====================================================

all:
	@echo ">>> 1. Building LIBRARY..."
	cd "$(ROOT_DIR)" && mkdir -p library/lib && \
	$(MAKE) -f Makefile --no-print-directory V=1 \
	TOOLCHAIN_DIR="$(TOOLCHAIN_DIR)" \
	CC="$(CC)" CXX="$(CXX)" AR="$(AR)" LD="$(LD)" LINKER="$(LINKER)" \
	CFLAGS="$(CFLAGS)" \
	LIBROBOTCONTROL_STATIC="$(LIBROBOTCONTROL_STATIC)"

	@echo ">>> 2. Building ALL EXAMPLES..."
	cd "$(ROOT_DIR)/examples" && \
	$(MAKE) -f Makefile --no-print-directory \
	TOOLCHAIN_DIR="$(TOOLCHAIN_DIR)" \
	GPIOD_SYSROOT="$(SYSROOT_WIN)" \
	CC="$(CC)" CXX="$(CXX)" AR="$(AR)" LD="$(LD)" LINKER="$(LINKER)" \
	CFLAGS="$(CFLAGS)" \
	LDFLAGS="$(LDFLAGS)"

clean:
	cd "$(ROOT_DIR)" && $(MAKE) -f Makefile --no-print-directory clean

install uninstall:
	cd "$(ROOT_DIR)" && $(MAKE) -f Makefile --no-print-directory $@

# =====================================================
# Deploy
# =====================================================

TARGET_USER := debian
TARGET_IP   := 192.168.7.2
TARGET_PATH := /home/$(TARGET_USER)/rc-build

deploy:
	@echo ">>> Deploying..."
	rsync -avz --delete "$(ROOT_DIR)/library/lib/" $(TARGET_USER)@$(TARGET_IP):$(TARGET_PATH)/lib/
	rsync -avz --delete "$(ROOT_DIR)/examples/"     $(TARGET_USER)@$(TARGET_IP):$(TARGET_PATH)/examples/

run:
	ssh $(TARGET_USER)@$(TARGET_IP) 'cd $(TARGET_PATH)/examples/bin && ./rc_test_drivers'