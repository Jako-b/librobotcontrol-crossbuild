	symlink = "bone/uart/2";
};
&i2c0 {
	symlink = "bone/i2c/0";
};
&i2c2 {
	symlink = "bone/i2c/2";
};
*/
/*
	Symlinks for:
		-> eqep => /sys/bus/counter/devices 
		   => dedicated udev rule [83-counter-noroot.rules]
		-> ehrpwm => /sys/class/pwm/ 
		   => dedicated udev rule [81-pwm-noroot.rule] 
		      + bb-symlinks.service + bb-symlinks.sh
*/

&tscadc {
	status = "okay";
	adc {
		ti,adc-channels = <0 1 2 3 4 5 6 7>;
	};
};

/*
&ecap0 {
	status="okay";
};
*/

&epwmss0 {
	status = "okay";
};

&eqep0 {
	pinctrl-names = "default";
	pinctrl-0 = <&eqep0_pins>;
	status = "okay";
};

&ehrpwm0 {
	status = "okay";
};

/*
&ecap1 {
	status="okay";
};
*/
&epwmss1 {
	status = "okay";
};

&eqep1 {
	pinctrl-names = "default";
	pinctrl-0 = <&eqep1_pins>;
	status = "okay";
};

&ehrpwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&ehrpwm1_pins>;
	status = "okay";
};

&epwmss2 {
	status = "okay";
};

&eqep2 {
	pinctrl-names = "default";
	pinctrl-0 = <&eqep2_pins>;
	status = "okay";
};