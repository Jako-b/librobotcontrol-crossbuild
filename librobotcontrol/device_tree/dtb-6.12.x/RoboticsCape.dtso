&{/chosen} {
    overlays {};
};

/*
 * Helper to show loaded overlays under: /proc/device-tree/chosen/overlays/
 */

/* 
	Reference: am335x-boneblue.dts
	
	ecapx + ehrpwmx are part of the epwmss system
	They need to be enabled individually!
	
	https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/tree/arch/arm/boot/dts/am335x-boneblue.dts?h=linux-6.1.y
	https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/tree/arch/arm/boot/dts/am33xx-l4.dtsi?h=linux-6.1.y
	
	Hints taken from this post: 
	https://github.com/beagleboard/BeagleBoard-DeviceTrees/pull/67
	https://github.com/beagleboard/BeagleBoard-DeviceTrees/pull/67/commits/0488dcbb863317c6be21b0682bbbd0216c5a5af7
*/

