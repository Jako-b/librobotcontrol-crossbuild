/*
 * Free up the pins used by the cape from the pinmux helpers.
 */
&ocp {

	/* TODO: Motor Control Pin frei geben */

	/* PWM1 */
	P9_14_pinmux { status = "disabled"; };	/* pwm: ehrpwm1a */
	P9_16_pinmux { status = "disabled"; };  /* pwm: ehrpwm1b */

	/* E1 */
	P9_42_pinmux { status = "disabled"; };	/* P9_42: gpmc_a1.gpio0_07 */
	P9_92_pinmux { status = "disabled"; };	/* P9_42.1: mcasp0_aclkr.gpio3_18 */
	P9_27_pinmux { status = "disabled"; };	/* P9_27: mcasp0_fsr.gpio3_19 */

	/* E2 */
	P8_35_pinmux { status = "disabled"; };	/* P8_35: (V2) lcd_data12.eQEP1A_in */
	P8_33_pinmux { status = "disabled"; };	/* P8_33: (V3) lcd_data13.eQEP1B_in */
};

/* partly taken from: am335x-boneblue.dts */
&am33xx_pinmux {
	/* free clkout2 which is P9.41 - AM335X_PIN_XDMA_EVENT_INTR1
	   => required for Pin used Motor Control = 
	   Solution NOT working => Kernel Startup fails! 
	   Original Code in:
	   /home/user/yocto/bbb_v3/build_scarthgap/tmp/work/bbx_rt-embcomp-linux-gnueabi/linux-ti-staging-rt/6.6.58+git/git/arch/arm/boot/dts/ti/omap/am335x-bone-common.dtsi
	   => solution: create a patch for: am335x-bone-common.dtsi
	*/

	/* PWM1 for Motor 1 and 2
	 * Note: The Motor driver TB6612FNG has internal pull-downs, therefore disable internal pulls.
	 *
	 * PWM: https://docs.beagleboard.io/latest/boards/capes/cape-interface-spec.html#pwm
	 * ehrpwm2 P9.14 P9.16
	 *
	 */
	ehrpwm1_pins: pinmux_ehrpwm1_pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_GPMC_A2, PIN_OUTPUT, MUX_MODE6)		/* (U14) P9_14: gpmc_a2.ehrpwm1a - PWM_1A */
			AM33XX_PADCONF(AM335X_PIN_GPMC_A3, PIN_OUTPUT, MUX_MODE6)		/* (T14) P9_16: gpmc_a3.ehrpwm1b - PWM_1B */
		>;
	};

	/* E1
	 * Note: No external pull-down, therefore enable internal pull-down.
	 */
	eqep0_pins: pinmux_eqep0_pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_MCASP0_ACLKR, PIN_INPUT_PULLDOWN, MUX_MODE1)	/* (B12) mcasp0_aclkr.eQEP0A_in */
			AM33XX_PADCONF(AM335X_PIN_MCASP0_FSR, PIN_INPUT_PULLDOWN, MUX_MODE1)	/* (C13) mcasp0_fsr.eQEP0B_in */
		>;
	};

	/* E2
	 * Note: according to schematics, both pins have external 100k pull-down resistors,
	 *       therefore disable the internal pull.
	 */
	eqep1_pins: pinmux_eqep1_pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA12, PIN_INPUT, MUX_MODE2)		/* (V2) lcd_data12.eQEP1A_in */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA13, PIN_INPUT, MUX_MODE2)		/* (V3) lcd_data13.eQEP1B_in */
		>;
	};

	/* No need here, done in ti/omap/am335-bone-common.dtsi 
	i2c2_pins: pinmux_i2c2_pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_UART1_CTSN, PIN_INPUT_PULLUP, MUX_MODE3)
			AM33XX_PADCONF(AM335X_PIN_UART1_RTSN, PIN_INPUT_PULLUP, MUX_MODE3)
		>;
	};
	*/

	/* Onboard Motor Driver Control Pins
	 * Note: The Motor driver TB6612FNG has internal pull-downs, therefore disable internal pulls.
	 * Branch: v5.10.x-ti-unified
	 */
	/* Onboard Motor Driver Control Pins
	 * Note: The Motor driver TB6612FNG has internal pull-downs, therefore disable internal pulls.
	 * defines found in:
	 * /home/user/yocto/bbb_v3/build_scarthgap/tmp/work/bbx_rt-embcomp-linux-gnueabi/linux-ti-staging-rt/6.6.58+git/git/include/dt-bindings/pinctrl/am33xx.h
	 */
	motorcontrol_pins: pinmux_motorcontrol_pins {
		pinctrl-single,pins = <
			/* BBBlue: AM33XX_PADCONF(AM335X_PIN_GPMC_CSN3, PIN_OUTPUT, MUX_MODE7)		 (T13) gpmc_csn3.gpio2[0] - MDIR_1A */
			AM33XX_PADCONF(AM335X_PIN_GPMC_BEN1, PIN_OUTPUT, MUX_MODE7)		/* (U18) gpmc_be1n.gpio1[28] - MDIR_1A == P9.12 MDIR_1A different from blue!!*/
			AM33XX_PADCONF(AM335X_PIN_GPMC_WPN, PIN_OUTPUT, MUX_MODE7)		/* (U17) gpmc_wpn.gpio0[31] - MDIR_1B */

			AM33XX_PADCONF(AM335X_PIN_GPMC_A0, PIN_OUTPUT, MUX_MODE7)		/* (R13) gpmc_a0.gpio1[16] - MDIR_2A */
			/* BBBlue: AM33XX_PADCONF(AM335X_PIN_LCD_DATA14, PIN_OUTPUT, MUX_MODE7)		 (V4) lcd_data14.gpio0[10] - MDIR_2B */
			AM33XX_PADCONF(AM335X_PIN_LCD_DATA11, PIN_OUTPUT, MUX_MODE7)		/* (U4) lcd_data11.gpio2[17] - MDIR_2B == P8.34 MDIR_2B different from blue!!*/

			AM33XX_PADCONF(AM335X_PIN_XDMA_EVENT_INTR1, PIN_OUTPUT, MUX_MODE7)	/* (D14) xdma_event_intr1.gpio0[20] - MOT_STBY */
		>;
	};

	/* IMU 9-Axis MPU-9250 */
/*
	mpu9250_pins: pinmux_mpu9250_pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_MCASP0_AHCLKX, PIN_INPUT, MUX_MODE7)		 (U10) mcasp0_ahclkx.gpio3[21] - INT_MPU 
		>;
	};
*/

	/* UT1 */
/*
	uart1_pins: pinmux_uart1_pins {
		pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_UART1_RXD, PIN_INPUT_PULLUP, MUX_MODE0)
			AM33XX_PADCONF(AM335X_PIN_UART1_TXD, PIN_OUTPUT_PULLDOWN, MUX_MODE0)
		>;
	};
*/

};

/* provide data for symlinks */
&uart0 {
	symlink = "bone/uart/0";
};
&uart2 {
	symlink = "bone/uart/2";
};
&i2c0 {
	symlink = "bone/i2c/0";
};
&i2c2 {
	symlink = "bone/i2c/2";
};
/*
	Symlinks for:
		-> eqep => /sys/bus/counter/devices 
		   => dedicated udev rule [83-counter-noroot.rules]
		-> ehrpwm => /sys/class/pwm/ 
		   => dedicated udev rule [81-pwm-noroot.rule] 
		      + bb-symlinks.service + bb-symlinks.sh
*/


&tscadc {
	status = "okay";
	adc {
		ti,adc-channels = <0 1 2 3 4 5 6 7>;
	};
};

/*
&ecap0 {
	status="okay";
};
*/
&epwmss0 {
	status = "okay";
};

&eqep0 {
	pinctrl-names = "default";
	pinctrl-0 = <&eqep0_pins>;
	status = "okay";
};

&ehrpwm0 {
	/* Does not seem to have any pins assigned in Kernel 4.14 DTS */
	status = "okay";
};

/*
&ecap1 {
	status="okay";
};
*/
&epwmss1 {
	status = "okay";
};

&eqep1 {
	pinctrl-names = "default";
	pinctrl-0 = <&eqep1_pins>;
	status = "okay";
};

/* use PWM1 for M1 and M2 */
&ehrpwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&ehrpwm1_pins>;
	status = "okay";
};

