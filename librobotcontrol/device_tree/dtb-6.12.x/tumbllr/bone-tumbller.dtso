/dts-v1/;
/plugin/;

#include <dt-bindings/pinctrl/am33xx.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/*
 * Helper to show loaded overlays under: /proc/device-tree/chosen/overlays/
 */
&{/chosen} {
	librobotcontrol_model = "tumbllr";

        overlays {
                bone-tumbller.kernel = "__TIMESTAMP__";
        };
};

/* 
Info (Orehek):
	Reference: am335x-boneblue.dts
	
	ecapx + ehrpwmx are part of the epwmss system
	They need to be enabled individually!
	
	https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/tree/arch/arm/boot/dts/am335x-boneblue.dts?h=linux-6.1.y
	https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/tree/arch/arm/boot/dts/am33xx-l4.dtsi?h=linux-6.1.y
	
	Hints taken from this post: 
	https://github.com/beagleboard/BeagleBoard-DeviceTrees/pull/67
	https://github.com/beagleboard/BeagleBoard-DeviceTrees/pull/67/commits/0488dcbb863317c6be21b0682bbbd0216c5a5af7
*/

/*
	From Robotic Cape / Robot Control Library
	=> https://github.com/beagleboard/librobotcontrol/blob/main/library/src/motor.c
	// motor pin definitions
	#define MDIR1A_CHIP		1	//gpio1.28	P9.12/P2.08
	#define MDIR1A_PIN		28	//gpio1.28	P9.12/P2.08
	#define MDIR1A_CHIP_BLUE	2	//gpio2.0	pin T13
	#define MDIR1A_PIN_BLUE		0	//gpio2.0	pin T13
	#define MDIR1B_CHIP		0	//gpio0.31	P9.13/P2.07
	#define MDIR1B_PIN		31	//gpio0.31	P9.13/P2.07

	#define MDIR2A_CHIP		1	//gpio1.16	P9.15
	#define MDIR2A_PIN		16	//gpio1.16	P9.15
	#define MDIR2A_CHIP_POCKET	0	//gpio0.26	P1.34
	#define MDIR2A_PIN_POCKET	26	//gpio0.26	P1.34
	#define MDIR2B_CHIP		2	//gpio2.17	P8.34
	#define MDIR2B_PIN		17	//gpio2.17	P8.34
	#define MDIR2B_CHIP_BLUE	0	//gpio0.10	P8_31
	#define MDIR2B_PIN_BLUE		10	//gpio0.10	P8_31
	#define MDIR2B_CHIP_POCKET	1	//gpio1.27	P2.02
	#define MDIR2B_PIN_POCKET	27	//gpio1.27	P2.02

	#define MDIR3B_CHIP		2	//gpio2.8	P8.43
	#define MDIR3B_PIN		8	//gpio2.8	P8.43
	#define MDIR3A_CHIP		2	//gpio2.9	P8.44
	#define MDIR3A_PIN		9	//gpio2.9	P8.44

	#define MDIR4A_CHIP		2	//gpio2.6	P8.45
	#define MDIR4A_PIN		6	//gpio2.6	P8.45
	#define MDIR4B_CHIP		2	//gpio2.7	P8.46
	#define MDIR4B_PIN		7	//gpio2.7	P8.46

	#define MOT_STBY		0,20	//gpio0.20	P9.41/P1.20

	=> https://github.com/beagleboard/librobotcontrol/blob/main/library/src/mpu/mpu.c
	//I2C bus and address definitions for Robotics Cape & bealgebone blue
	#define RC_IMU_BUS		2
	#define RC_IMU_INTERRUPT_PIN_CHIP 3
	#define RC_IMU_INTERRUPT_PIN_PIN  21 // gpio3.21 P9.25	

	=> Pin Mapping on Tumbller Schematic see: 
		* table 'PinMap_RoboticsCape_TumbllerPCBv1.3' 
		* in 'MaterialList_PinMap.ods' 
		* in 'git\tumbllerpcb_pcb-design\TumbllerPCB\Parts'

*/

